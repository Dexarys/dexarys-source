      super(props);\r\n    }\r\n\r\n    render() {\r\n        return (\r\n            <div>\r\n                <div className=\"content padding-64\" id=\"about\">\r\n                    <h3 className=\"text-center title\">ABOUT ME</h3>\r\n                    <div className=\"row\">\r\n                        <div className=\"col m6 text-center\">\r\n                            <img className=\"img-me\" src={mf} alt=\"me\" />\r\n                        </div>\r\n                        <p className=\"text-about\">\r\n                            {this.props.biography}\r\n                        </p>\r\n                    </div>\r\n                    <div className=\"link-buttons flex justify-content-center\">\r\n                        <a href=\"#contact\" className=\"link text-center\" rel=\"noopener noreferrer\"><div className=\"button\">Contact Me</div></a>\r\n                        <a href=\"#\" target=\"_blank\" className=\"link text-center\" rel=\"noopener noreferrer\"><div className=\"button\">Download CV</div></a>\r\n                    </div>\r\n                </div>\r\n\r\n                <div className=\"bgimg-4 display-container opacity-min\">\r\n                    <div className=\"display-middle\">\r\n                        <span className=\"wide text-white xlarge black padding-large\">PORTFOLIO</span>\r\n                    </div>\r\n                </div>\r\n                <div className=\"padding-64\" id=\"portfolio\">\r\n                    <div className=\"content\">\r\n                        <Projects />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}\r\n\r\nexport default withTitle(HomePage, \"Home\");","C:\\Users\\fallo\\Documents\\Dev\\React\\dexarys\\src\\components\\loader\\Loader.js",[],"C:\\Users\\fallo\\Documents\\Dev\\React\\dexarys\\src\\components\\footer\\Footer.js",[],"C:\\Users\\fallo\\Documents\\Dev\\React\\dexarys\\src\\components\\navigation\\Navigation.js",[],"C:\\Users\\fallo\\Documents\\Dev\\React\\dexarys\\src\\api\\apiKeys.js",[],"C:\\Users\\fallo\\Documents\\Dev\\React\\dexarys\\src\\components\\title\\Context.js",["54"],"import React from 'react';\r\n\r\nexport function withTitle(Component, title) {\r\n    const DEFAULT_TITLE = 'Matthieu Fallourd';\r\n\r\n    return class extends React.Component {\r\n        componentWillMount() {\r\n            document.title = (title ? title + \" | \" : \"\") + DEFAULT_TITLE;\r\n        }\r\n\r\n        render() {\r\n            return <Component titlePage={ title } { ...this.props } />;\r\n        }\r\n    }\r\n}\r\n\r\nexport default { withTitle };","C:\\Users\\fallo\\Documents\\Dev\\React\\dexarys\\src\\components\\projects\\Projects.js",["55"],"import React, { Component } from 'react';\r\nimport firebase from '../../api/firebase';\r\n\r\nimport './css/Projects.css';\r\n\r\nclass Projects extends Component {\r\n\r\n    state = {\r\n        projects: [],\r\n        visible: false\r\n    }\r\n\r\n    constructor(props) {\r\n        super(props);\r\n        this.dropdown = this.dropdown.bind(this);\r\n    }\r\n\r\n    componentWillMount() {\r\n        this.projectsRef = firebase.database().ref('/projects');\r\n        this.projectsRef.orderByChild(\"order\").limitToLast(9).on('value', (snap) => {\r\n            let data = [];\r\n            snap.forEach((childSnap) => { data.push(childSnap.val()) })\r\n            this.setState({ projects: data });\r\n        });\r\n    }\r\n\r\n    dropdown() {\r\n        this.setState({visible: !this.state.visible});\r\n    }\r\n\r\n    render() {\r\n        return (\r\n            <div>\r\n                <h3 className=\"text-center title\">PROJECTS</h3>\r\n                <div className=\"flex justify-content-evenly wrap\">\r\n                    {\r\n                        this.state.projects.map((item, i) => (\r\n                            <a key={i} href={item.link} target=\"_blank\" className=\"link-project\">\r\n                                <div key={i} className=\"card\">\r\n                                    <div>\r\n                                        <img className=\"projects_img\" src={require('../../assets/content/'+item.source)} alt={item.desc_img} />\r\n                                    </div>\r\n                                    <p className=\"projects_name\">{item.name}</p>\r\n                                    <p className=\"projects_desc\">{item.description}</p>\r\n                                </div>\r\n                            </a>\r\n                        ))\r\n                    }\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n\r\n}\r\n\r\nexport default Projects;",{"ruleId":"56","replacedBy":"57"},{"ruleId":"58","replacedBy":"59"},{"ruleId":"60","severity":1,"message":"61","line":14,"column":5,"nodeType":"62","messageId":"63","endLine":16,"endColumn":6},{"ruleId":"64","severity":1,"message":"65","line":33,"column":25,"nodeType":"66","endLine":33,"endColumn":108},{"ruleId":"67","severity":1,"message":"68","line":17,"column":1,"nodeType":"69","endLine":17,"endColumn":30},{"ruleId":"70","severity":1,"message":"71","line":38,"column":57,"nodeType":"72","endLine":38,"endColumn":72},"no-native-reassign",["73"],"no-negated-in-lhs",["74"],"no-useless-constructor","Useless constructor.","MethodDefinition","noUselessConstructor","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","JSXOpeningElement","import/no-anonymous-default-export","Assign object to a variable before exporting as module default","ExportDefaultDeclaration","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","JSXAttribute","no-global-assign","no-unsafe-negation"]